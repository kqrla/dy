---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "concepts — the dysfunctional executives";
---
<BaseLayout {title}>
  <article class="container">
    <div class="section-head">
      <h1>concepts</h1>
      <span class="hint">ideas for thinking across disciplines and building broad knowledge</span>
    </div>

    <div class="grid">
      <a class="card" data-accent="p3" href="/guides/polymath">
        <div class="icon"><i class="fa-solid fa-brain" aria-hidden="true"></i></div>
        <div>
          <h3>polymath</h3>
          <p>deep knowledge across multiple fields</p>
        </div>
      </a>

      <a class="card" data-accent="p2" href="/guides/multipotentialite">
        <div class="icon"><i class="fa-solid fa-infinity" aria-hidden="true"></i></div>
        <div>
          <h3>multipotentialite</h3>
          <p>many interests, refusal to choose one</p>
        </div>
      </a>

      <a class="card" data-accent="p4" href="/guides/interdisciplinary">
        <div class="icon"><i class="fa-solid fa-link" aria-hidden="true"></i></div>
        <div>
          <h3>interdisciplinary thinking</h3>
          <p>work at the intersection of fields</p>
        </div>
      </a>
    </div>

    <div class="section-head" style="margin-top:24px">
      <h2>knowledge networks</h2>
      <span class="hint">how ideas connect</span>
    </div>
    <div class="grid">
      <a class="card" data-accent="p5" href="/guides/interwingularity">
        <div class="icon"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i></div>
        <div>
          <h3>interwingularity</h3>
          <p>linking ideas across your knowledge</p>
        </div>
      </a>

      <a class="card" data-accent="p1" href="/guides/knowledge-networks">
        <div class="icon"><i class="fa-solid fa-circle-nodes" aria-hidden="true"></i></div>
        <div>
          <h3>knowledge networks</h3>
          <p>structure of how you know things</p>
        </div>
      </a>

      <a class="card" data-accent="p2" href="/guides/associativity">
        <div class="icon"><i class="fa-solid fa-bolt" aria-hidden="true"></i></div>
        <div>
          <h3>associativity</h3>
          <p>how freely ideas trigger other ideas</p>
        </div>
      </a>
    </div>

    <div class="section-head" style="margin-top:24px">
      <h2>memory & neurodiversity</h2>
      <span class="hint">how your brain works</span>
    </div>
    <div class="grid">
      <a class="card" data-accent="p4" href="/guides/retentive-memory">
        <div class="icon"><i class="fa-solid fa-hard-drive" aria-hidden="true"></i></div>
        <div>
          <h3>retentive memory</h3>
          <p>holding and recalling information</p>
        </div>
      </a>

      <a class="card" data-accent="p3" href="/guides/adhd-pattern-recognition">
        <div class="icon"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></div>
        <div>
          <h3>adhd & pattern recognition</h3>
          <p>spotting what others miss</p>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>
